<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Server.Engines.ModernSpawner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModernSpawner.Tests" />
  </ItemGroup>

  <!-- ModernUO is built as Release under our Analyze configuration so only this project is analyzed. -->
  <ItemGroup>
    <ProjectReference Include="$(ModernUORoot)Projects/Server/Server.csproj">
      <SetConfiguration Condition="'$(Configuration)'=='Analyze'">Configuration=Release</SetConfiguration>
    </ProjectReference>
    <ProjectReference Include="$(ModernUORoot)Projects/UOContent/UOContent.csproj">
      <SetConfiguration Condition="'$(Configuration)'=='Analyze'">Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModernUO.Serialization.Generator" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Migrations/*.v*.json" />
  </ItemGroup>
</Project>
